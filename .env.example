# Development defaults. Production values must be supplied by the runtime.
SCAMLENS_ENV=development
SCAMLENS_PUBLIC_ORIGIN=https://replace-with-your-production-origin.example
SCAMLENS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SCAMLENS_TRUST_FORWARDED_HEADERS=false
SCAMLENS_INFERENCE_REQUESTS_PER_MINUTE=60
SCAMLENS_OCR_REQUESTS_PER_MINUTE=10
SCAMLENS_PERFORMANCE_REQUESTS_PER_MINUTE=120
SCAMLENS_OCR_CONCURRENCY_LIMIT=2
SCAMLENS_OCR_TIMEOUT_SECONDS=15
